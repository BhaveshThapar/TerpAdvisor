# Database
# Local Postgres (docker-compose). For Neon, you can paste the console connection
# string verbatim into DATABASE_URL — the app strips libpq SSL params, adds the
# asyncpg driver, derives DATABASE_URL_SYNC, and auto-enables SSL for *.neon.tech.
DATABASE_URL=postgresql+asyncpg://terpadvisor:terpadvisor_dev@localhost:5432/terpadvisor
DATABASE_URL_SYNC=postgresql://terpadvisor:terpadvisor_dev@localhost:5432/terpadvisor
# Force SSL (ssl=require for asyncpg, sslmode=require for psycopg2) on non-Neon managed DBs.
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379/0
# Set false to run without Redis — cache still uses in-process LRU + Postgres layers.
REDIS_ENABLED=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Auth (REQUIRED in production)
SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo mode (set to true only for local development)
DEMO_MODE=false

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# External APIs
PLANETTERP_BASE_URL=https://planetterp.com/api/v1
UMDIO_BASE_URL=https://api.umd.io/v1
